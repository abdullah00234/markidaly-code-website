# Resend (https://resend.com) — used by /api/growth-audit to email form
# submissions to a real inbox. Free tier covers low-volume lead forms.
RESEND_API_KEY=

# Where growth-audit form submissions should land.
GROWTH_AUDIT_TO_EMAIL=

# Optional — defaults to Resend's shared onboarding sender. Set this once
# you've verified a sending domain in Resend, e.g.:
# GROWTH_AUDIT_FROM_EMAIL="Markidly Growth Audit <audit@markidly.com>"
GROWTH_AUDIT_FROM_EMAIL=
